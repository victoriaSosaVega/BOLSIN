# Copiar este archivo como .env y completar los valores.
# El .env real NO se sube a git.

# jdbc:postgresql://HOST:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# postgres.<ref-del-proyecto>
SUPABASE_DB_USER=

# Contrasena de la base de datos (no es ninguna de las API keys)
SUPABASE_DB_PASSWORD=
